<Window x:Class="prakticke_zadani.View.New_car"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prakticke_zadani"
        mc:Ignorable="d"
        Title="New_car" Height="400" Width="600">
    <Grid>

        <Label Content="Přidat auto" HorizontalAlignment="Center" Margin="0,24,0,0" VerticalAlignment="Top" Width="310" HorizontalContentAlignment="Center" FontSize="30"/>
        <Calendar HorizontalAlignment="Left" Margin="400,104,0,0" VerticalAlignment="Top"/>
        <Label Content="Název modelu :" HorizontalAlignment="Left" Margin="43,107,0,0" VerticalAlignment="Top"/>
        <Label Content="Cena :" HorizontalAlignment="Left" Margin="43,146,0,0" VerticalAlignment="Top"/>
        <Label Content="DPH :" HorizontalAlignment="Left" Margin="43,187,0,0" VerticalAlignment="Top"/>
        <Label Content="Datum prodeje :" HorizontalAlignment="Left" Margin="285,107,0,0" VerticalAlignment="Top"/>

        <TextBox Name="modelText" HorizontalAlignment="Left" Margin="148,111,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="priceText" HorizontalAlignment="Left" Margin="148,150,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <TextBox Name="dphText" HorizontalAlignment="Left" Margin="148,191,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"/>
        <Calendar Name="dateCalendar" HorizontalAlignment="Left" Margin="400,104,0,0" VerticalAlignment="Top"/>



        <Button Name="Create_btn"  Content="Vytvořit" HorizontalAlignment="Left" Margin="320,304,0,0" VerticalAlignment="Top" Click="Create_btn_Click"/>
        <Button Content="Zrušit" HorizontalAlignment="Left" Margin="245,304,0,0" VerticalAlignment="Top" Click="Button_Click"/>

    </Grid>
</Window>
