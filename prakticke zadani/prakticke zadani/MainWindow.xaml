<Window x:Class="prakticke_zadani.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:prakticke_zadani"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Label Content="Auta" HorizontalAlignment="Center" Margin="0,24,0,0" VerticalAlignment="Top" Width="310" HorizontalContentAlignment="Center" FontSize="30"/>


        <TextBlock Name="filepath" HorizontalAlignment="Center" Margin="0,344,0,0" TextWrapping="Wrap" Text="path" VerticalAlignment="Top" Width="400"/>
        <Button Name="Load_btn" Content="Načíst soubor" HorizontalAlignment="Left" Margin="300,374,0,0" VerticalAlignment="Top" Click="Load_btn_Click"/>
        <Button Name="AddCar_btn" Content="Přidat auto" HorizontalAlignment="Left" Margin="478,374,0,0" VerticalAlignment="Top" Click="AddCar_btn_Click"/>
        <Button Name="Export_btn" Content="Exportovat" HorizontalAlignment="Left" Margin="400,374,0,0" VerticalAlignment="Top" Click="Export_btn_Click"/>
        
        <TextBlock Name="autobox"  HorizontalAlignment="Left" Margin="200,0,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Center" Height="170" Width="355"/>



    </Grid>
</Window>
